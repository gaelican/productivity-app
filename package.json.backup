{
  "name": "@productivity-app/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "test": "jest",
    "test:interactive": "node src/screens/Tasks/__tests__/run-interactive-test.js",
    "test:task-edit": "jest src/screens/Tasks/__tests__/TaskEditScreen.interactive.test.tsx --verbose",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "@expo/metro-runtime": "~3.2.3",
    "@nozbe/watermelondb": "^0.27.1",
    "@nozbe/with-observables": "^1.6.0",
    "@productivity-app/design-system": "workspace:*",
    "@productivity-app/state": "workspace:*",
    "@productivity-app/types": "workspace:*",
    "@productivity-app/utils": "workspace:*",
    "@productivity/widget-bridge": "workspace:*",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-navigation/stack": "^6.3.20",
    "@reduxjs/toolkit": "^2.0.1",
    "@types/uuid": "^10.0.0",
    "chrono-node": "^2.7.0",
    "expo": "~51.0.0",
    "expo-battery": "~8.0.1",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-linear-gradient": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "nativewind": "^4.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.6",
    "react-redux": "^9.0.4",
    "uuid": "^11.0.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.23.6",
    "@babel/plugin-transform-class-properties": "^7.23.3",
    "@testing-library/react-native": "^12.4.1",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "babel-preset-expo": "~11.0.0",
    "chalk": "^4.1.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "react-native-cli": "^2.0.1",
    "typescript": "^5.3.3"
  },
  "private": true
}