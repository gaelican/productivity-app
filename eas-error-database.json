        "success_count": 203,
        "failure_count": 4
      },
      {
        "id": "java_home_not_set",
        "pattern": "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH",
        "regex": "ERROR: JAVA_HOME is not set",
        "fix": {
          "file": "eas.json",
          "action": "update_json",
          "path": "build.production.android.env",
          "value": {
