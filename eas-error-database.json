    "dependency_errors": [
      {
        "id": "duplicate_classes_kotlin",
        "pattern": "Duplicate class kotlin.collections.jdk8.CollectionsJDK8Kt found in modules",
        "regex": "Duplicate class (.*) found in modules",
        "fix": {
          "file": "android/app/build.gradle",
          "action": "add_if_missing",
          "section": "android",
          "content": "packagingOptions {\\n    pickFirst '**/libc++_shared.so'\\n    pickFirst '**/libjsc.so'\\n    exclude 'META-INF/DEPENDENCIES'\\n}"
        },
        "confidence": 0.85,
        "success_count": 45,
