        "pattern": "SDK location not found. Define location with an ANDROID_SDK_ROOT environment variable",
        "regex": "SDK location not found",
        "fix": {
          "file": "android/local.properties",
          "action": "create",
          "content": "sdk.dir=/opt/android-sdk"
        },
